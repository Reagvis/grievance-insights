output "base_url" { value = var.enable_public_endpoint ? "https://${var.hostname}" : null }
output "service_repository_url" { value = data.aws_ecr_repository.service.repository_url }
output "public_keys_secret_arn" { value = aws_secretsmanager_secret.public_keys.arn }
output "audit_hmac_secret_arn" { value = aws_secretsmanager_secret.audit_hmac.arn }
output "credential_table" { value = aws_dynamodb_table.credentials.name }
output "client_authorization_table" { value = aws_dynamodb_table.clients.name }
output "registry_table" { value = aws_dynamodb_table.registry.name }
output "audit_table" { value = aws_dynamodb_table.audit.name }
output "cognito_user_pool_id" { value = aws_cognito_user_pool.eoffice.id }
output "cognito_initial_client_id" { value = aws_cognito_user_pool_client.eoffice.id }
output "cognito_token_endpoint" { value = "https://${aws_cognito_user_pool_domain.eoffice.domain}.auth.${var.aws_region}.amazoncognito.com/oauth2/token" }
output "cognito_scopes" { value = [for name in keys(local.api_scopes) : "${aws_cognito_resource_server.eoffice.identifier}/${name}"] }

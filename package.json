{
  "name": "grievance-insights",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backend:package": "node scripts/package-auth-lambda.mjs",
    "backend:test": "vitest run backend",
    "backend:typecheck": "tsc -p backend/tsconfig.json",
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:aws": "tsc -b && vite build --mode aws --base=/",
    "build:pages": "tsc -b && vite build --mode pages --base=./",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:dashboard:browser": "node scripts/test-dashboard-browser.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1166.0",
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1166.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.68.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
